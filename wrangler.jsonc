{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "github-flow-analytics",
  "main": "cloudflare_worker.py",
  "compatibility_date": "2026-10-05",
  "compatibility_flags": [
    "python_workers"
  ],
  "workers_dev": true,
  "limits": {
    "cpu_ms": 30000
  },
  "vars": {
    "AUTH_REQUIRED": "true",
    "GOOGLE_OAUTH_CLIENT_ID": "914195447285-huoatl4c0c0e8qrcou5m3n2aalaj7jri.apps.googleusercontent.com"
  },
  "assets": {
    "directory": "./public/",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "kv_namespaces": [
    {
      "binding": "ANALYTICS_CACHE",
      "id": "b77e4c7c37504ab6a400f480a5ecdd50"
    }
  ],
  "d1_databases": [
    {
      "binding": "USERS_DB",
      "database_name": "github-flow-analytics-users",
      "database_id": "235f3759-0596-4598-aa53-f19ba7b65d8a"
    }
  ],
  "ratelimits": [
    {
      "name": "ANALYZE_LIMIT",
      "namespace_id": "1001",
      "simple": {
        "limit": 6,
        "period": 60
      }
    },
    {
      "name": "CHAT_LIMIT",
      "namespace_id": "1002",
      "simple": {
        "limit": 12,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "github-analytics.yuvalyeret.com",
      "custom_domain": true
    }
  ]
}
